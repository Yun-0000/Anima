# Copy to backend/.env. Never commit the real file.
# Without any key, the app works with scripted replies and no provider is called.

# Your own OpenAI key: real chat replies and the gesture director.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
# Reasoning effort of the chat model: none (fastest), minimal, low, medium, high.
OPENAI_CHAT_REASONING=none
# Reasoning effort of the director, which picks gestures and expressions.
OPENAI_DIRECTOR_REASONING=low

# Your own ElevenLabs key: each character's voice, the same in Chat and Voice mode.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# Voice mode: run `python scripts/setup_voice_agent.py` (the key needs the ElevenAgents
# read and write permissions) and paste the agent ID it prints.
ELEVENLABS_AGENT_ID=
# Optional: your own ElevenLabs voices instead of the defaults.
ELEVENLABS_VOICE_ID_MIO=
ELEVENLABS_VOICE_ID_RIN=
ELEVENLABS_VOICE_ID_KAI=

# Browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
