# Local no-key mode
LOCAL_MODE=true

# Text mode LLM. Add your own key when leaving LOCAL_MODE.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o

# Voice mode motion/expression planner
OPENAI_MOTION_MODEL=gpt-5.4-mini

# Text mode TTS. Add voice IDs from your own ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_JANE=
ELEVENLABS_VOICE_ID_HANS=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Voice mode, speech-to-speech
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Optional OpenAI realtime voices. Leave blank to use app defaults.
OPENAI_REALTIME_VOICE=
OPENAI_REALTIME_VOICE_JANE=
OPENAI_REALTIME_VOICE_HANS=
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Server
HOST=0.0.0.0
PORT=8001

# CORS
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
